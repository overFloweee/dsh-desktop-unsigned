# CI 专用的 apps/desktop/.env.macos
#
# 官方 package-target 强制"发布字段只从该文件读"（.env.macos，不回落 shell 环境变量），
# 所以流水线里必须先把这份文件写进去。
#
# 我们是**未签名**构建：签名/公证字段只给"格式合法"的占位值——它们不会被真正使用：
#   1) prepare-only 路径不会去导入 p12 或调用 Apple 服务；
#   2) electron-builder 用的 config/unsigned-mac.config.mjs 已把 mac.identity 覆盖成 null、
#      notarize=false，并删掉了 afterSign（验签）等钩子。
# 但官方的 validateDesktopPackageEnvironment 在 darwin 上**即使 prepare-only 也会**校验：
#   - 恰好一个公证策略（这里用 APPLE_ID / APPLE_APP_SPECIFIC_PASSWORD / APPLE_TEAM_ID）
#   - CSC_LINK 指向一个"可读文件"、CSC_KEY_PASSWORD 已设置（显式空值）
#   - test 部署必须有 DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN + allowedAuthOrigins
# 因此下面给的是：一次性自签名 p12（CI 里用 openssl 现生成）+ 占位凭据 + 内部测试 origin。
DSH_DESKTOP_APP_ID=com.deepseek.harness
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=https://download-test.deepseek.com
DOWNLOAD_TEST_RELEASE_ID=0123456789abcdef0123456789abcdef
DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://harness-test.deepseek.com
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://harness-test.deepseek.com"]}'
DSH_DESKTOP_MACOS_SIGNING_IDENTITY=CI_UNSIGNED_BUILD
DSH_DESKTOP_MACOS_TEAM_ID=AAAAAAAAAA
APPLE_ID=ci@example.com
APPLE_APP_SPECIFIC_PASSWORD=ci-not-a-real-password
APPLE_TEAM_ID=AAAAAAAAAA
CSC_LINK=./ci-dummy.p12
CSC_KEY_PASSWORD=
