# CI 专用的 apps/desktop/.env.macos
#
# 官方 package-target 强制"发布字段只从该文件读"（.env.macos，不回落 shell 环境变量），
# 所以流水线里必须先把这份文件写进去。
#
# 我们是**未签名**构建：签名/公证字段只给"格式合法"的假值——它们不会被真的使用，因为
#   1) prepare-only 路径不触发签名/公证前置；
#   2) electron-builder 用的 config/unsigned-mac.config.mjs 已把 mac.identity 覆盖成 null、
#      notarize 设为 false，并删掉了 afterSign（验签）等钩子。
DSH_DESKTOP_APP_ID=com.deepseek.harness
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=https://download-test.deepseek.com
DOWNLOAD_TEST_RELEASE_ID=0123456789abcdef0123456789abcdef
DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4
DSH_DESKTOP_MACOS_SIGNING_IDENTITY=CI_UNSIGNED_BUILD
DSH_DESKTOP_MACOS_TEAM_ID=AAAAAAAAAA
APPLE_ID=ci@example.com
APPLE_APP_SPECIFIC_PASSWORD=ci-not-a-real-password
APPLE_TEAM_ID=AAAAAAAAAA
